# =============================================================================
# BeeMatch · .gitignore
# =============================================================================

# --- Secretos ----------------------------------------------------------------
# Nunca subir credenciales de OneDrive, claves del servicio de IA ni el
# JWT_SECRET (RNF10). El .env.example sí se versiona como plantilla.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Entornos virtuales
.venv/
venv/
ENV/
env/

# Pruebas y calidad
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
.dmypy.json

# --- Base de datos local -----------------------------------------------------
# La base de desarrollo se regenera con `python -m backend.crear_usuario`.
# Además contiene datos personales de candidatos: no debe versionarse (RNF13).
data/*.db
data/*.sqlite
data/*.sqlite3
*.db-journal

# --- Archivos generados ------------------------------------------------------
# Exportaciones de preselección con datos de candidatos reales.
storage/*
!storage/.gitkeep

# --- Node / frontend ---------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# --- Editores ----------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# --- Sistema operativo -------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Hojas de vida de prueba -------------------------------------------------
# Si alguien deja CVs reales en el repo para probar la indexación, que no se
# suban por accidente.
*.pdf
*.docx
*.doc
!docs/**/*.pdf