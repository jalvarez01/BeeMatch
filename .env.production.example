# Plantilla para el servidor. Copiar a .env.production, completar y proteger:
#   cp .env.production.example .env.production && chmod 600 .env.production
# Nunca se sube al repositorio (.gitignore ignora .env.*).

# --- Dirección pública -------------------------------------------------------
# :80 para probar con la IP pública (HTTP). Con un dominio que ya apunte al
# servidor, Caddy consigue el certificado HTTPS solo.
SITIO=:80
ALLOWED_ORIGINS=http://localhost

# --- Base de datos -----------------------------------------------------------
# La usan el contenedor de PostgreSQL y la cadena de conexión del compose.
# Generar con: openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=

# --- Seguridad ---------------------------------------------------------------
# Mínimo 32 caracteres. Generar con: openssl rand -hex 32
# La API se niega a arrancar con el valor de ejemplo (ENTORNO=produccion).
JWT_SECRET=
# Cifra el secreto del repositorio de hojas de vida en base de datos. Si se deja
# vacío se deriva de JWT_SECRET (y rotar JWT_SECRET dejaría ilegible ese secreto).
# Generar con: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
JWT_EXPIRACION_MINUTOS=30
DOMINIO_CORREO=bee.com.co

# Superusuaria: se crea al primer arranque si no existe ninguna. Mínimo 12 caracteres.
SUPERUSUARIO_CORREO=
SUPERUSUARIO_NOMBRE=Diana
SUPERUSUARIO_PASSWORD=

# --- Servicio de IA (OpenAI) -------------------------------------------------
LLM_API_KEY=
LLM_MODELO=gpt-4o-mini
EMBEDDING_API_KEY=
EMBEDDING_MODELO=text-embedding-3-small
EMBEDDING_DIMENSIONES=1536

# --- Motor de matching -------------------------------------------------------
TOP_N_RESULTADOS=5
FINALISTAS_RERANK=20
UMBRAL_AFINIDAD_MINIMA=60

# --- Repositorio de hojas de vida --------------------------------------------
# Lo normal es conectarlo desde la aplicación (Configuración, HU-05) una vez
# dentro. Estas variables solo siembran la primera conexión.
SYNC_INTERVALO_HORAS=6
GDRIVE_CARPETA_ID=
# Ruta DENTRO del contenedor. Montar el archivo con un volumen si se usa.
# GDRIVE_ARCHIVO_CREDENCIALES=/run/secrets/beematch-credenciales.json
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_CARPETA_CV=/HojasDeVida
