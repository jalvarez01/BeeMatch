# --- Base de datos -----------------------------------------------------------
# Desarrollo (por defecto): SQLite. Producción: PostgreSQL + pgvector.
# DATABASE_URL=postgresql+psycopg://beematch:beematch@localhost:5432/beematch

# --- Cola de trabajos --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Microsoft Graph / OneDrive (solo lectura) -------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_CARPETA_CV=/HojasDeVida
SYNC_INTERVALO_HORAS=6

# --- Google Drive (solo lectura) ---------------------------------------------
# Semilla de arranque: si al iniciar no hay una conexión registrada y existe
# beematch-credenciales.json en la raíz del proyecto, se registra Google Drive
# con esa cuenta de servicio sobre esta carpeta. El archivo no se versiona.
GDRIVE_CARPETA_ID=1H7-p-d3auJOzrw660zGfmKa5drW0Hn_V
# GDRIVE_ARCHIVO_CREDENCIALES=/ruta/al/beematch-credenciales.json

# --- Servicio de IA ----------------------------------------------------------
# Clave de Anthropic (re-ranking y explicación de resultados).
LLM_API_KEY=
LLM_MODELO=claude-opus-5

# Clave de OpenAI (vectorización de CV y consultas). Es un proveedor distinto
# al del LLM: Anthropic no ofrece API de embeddings.
EMBEDDING_API_KEY=
EMBEDDING_MODELO=text-embedding-3-small
EMBEDDING_DIMENSIONES=1536
EMBEDDING_URL=https://api.openai.com/v1/embeddings
EMBEDDING_LOTE=96

# --- Motor de matching -------------------------------------------------------
TOP_N_RESULTADOS=5
FINALISTAS_RERANK=20
UMBRAL_AFINIDAD_MINIMA=60

# --- Seguridad ---------------------------------------------------------------
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRACION_HORAS=8
ALLOWED_ORIGINS=http://localhost:5173
