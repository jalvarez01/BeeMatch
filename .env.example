# --- Base de datos -----------------------------------------------------------
# Desarrollo (por defecto): SQLite. Producción: PostgreSQL + pgvector.
# DATABASE_URL=postgresql+psycopg://beematch:beematch@localhost:5432/beematch

# --- Cola de trabajos --------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Microsoft Graph / OneDrive (solo lectura) -------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
ONEDRIVE_DRIVE_ID=
ONEDRIVE_CARPETA_CV=/HojasDeVida
SYNC_INTERVALO_HORAS=6

# --- Servicio de IA ----------------------------------------------------------
LLM_API_KEY=
LLM_MODELO=claude-sonnet-4-6
EMBEDDING_MODELO=text-embedding-3-small
EMBEDDING_DIMENSIONES=1536

# --- Motor de matching -------------------------------------------------------
TOP_N_RESULTADOS=5
FINALISTAS_RERANK=20
UMBRAL_AFINIDAD_MINIMA=60

# --- Seguridad ---------------------------------------------------------------
JWT_SECRET=cambiar-en-produccion
JWT_EXPIRACION_HORAS=8
ALLOWED_ORIGINS=http://localhost:5173
